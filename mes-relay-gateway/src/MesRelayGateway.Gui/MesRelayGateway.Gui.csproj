<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MesRelayGateway.Gui</RootNamespace>
    <AssemblyName>MesRelayGatewayGui</AssemblyName>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF's XAML binding engine needs real culture data (XmlLanguage.GetSpecificCulture);
         InvariantGlobalization=true makes every window crash on show with
         "Cannot find non-neutral culture related to 'en-us'." Keep it off here even though
         Core/Console use it. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MesRelayGateway.Core\MesRelayGateway.Core.csproj" />
  </ItemGroup>

</Project>
